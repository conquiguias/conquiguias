{
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/panel$",
      "dest": "/panel.html"
    },
    {
      "src": "^/panel\\.html$",
      "dest": "/panel.html"
    },
    {
      "src": "^/index$",
      "dest": "/index.html"
    },
    {
      "src": "^/login$",
      "dest": "/index.html"
    },
    {
      "src": "^/privacidad$",
      "dest": "/privacidad.html"
    },
    {
      "src": "^/terminos$",
      "dest": "/terminos.html"
    },
    {
      "src": "^/contacto$",
      "dest": "/contacto.html"
    },
    {
      "src": "^/acerca-de$",
      "dest": "/acerca-de.html"
    },
    {
      "src": "^/blog/?$",
      "dest": "/blog/index.html"
    },
    {
      "src": "^/blog/([^/]+)$",
      "dest": "/blog/$1.html"
    },
    {
      "src": "^/formulario$",
      "dest": "/formulario.html"
    },
    {
      "src": "^/post/([^/]+)$",
      "dest": "/post?id=$1"
    },
    {
      "src": "^/share/([^/]+)$",
      "dest": "/api/post-share?id=$1"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/sitemap.xml"
    }
  ],
  "crons": [
    {
      "path": "/api/social?action=send-task-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/social?action=cleanup-rate-limits",
      "schedule": "30 6 * * *"
    }
  ]
}
