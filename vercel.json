{
  "rewrites": [
    {
      "source": "/index",
      "destination": "/index.html"
    },
    {
      "source": "/panel",
      "destination": "/panel.html"
    },
    {
      "source": "/formulario",
      "destination": "/formulario.html"
    },
    {
      "source": "/post/:id",
      "destination": "/post?id=:id"
    },
    {
      "source": "/share/:id",
      "destination": "/api/post-share?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/post-share?action=sitemap"
    }
  ]
}
