{
  "redirects": [
    {
      "source": "/panel",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/panel.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/panel.html"
    },
    {
      "source": "/index",
      "destination": "/panel.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/panel",
      "destination": "/panel.html"
    },
    {
      "source": "/formulario",
      "destination": "/formulario.html"
    },
    {
      "source": "/post/:id",
      "destination": "/post?id=:id"
    },
    {
      "source": "/share/:id",
      "destination": "/api/post-share?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/post-share?action=sitemap"
    }
  ]
}
